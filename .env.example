# ===========================================
# Grden IA - Configuration
# ===========================================

# Nom de l'application
WEBUI_NAME=Grden IA

# URL d'Ollama (modeles locaux)
OLLAMA_BASE_URL=http://localhost:11434

# Cle secrete pour la session (changez-la !)
WEBUI_SECRET_KEY=changez-moi-en-production

# Repertoire de stockage des donnees
DATA_DIR=./data

# Modeles par defaut (separes par des virgules)
DEFAULT_MODELS=qwen2.5-coder:1.5b,qwen2.5:0.5b,minicpm-v4.6:latest,granite4.1-guardian:8b

# Locale par defaut
DEFAULT_LOCALE=fr-FR

# ===========================================
# Gemini API (optionnel)
# ===========================================
# Obtenez votre cle sur : https://aistudio.google.com/apikey
# OPENAI_API_KEY=votre-cle-gemini-ici
# OPENAI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ===========================================
# Fonctionnalites
# ===========================================
# Activer/desactiver la RAG (Recherche Augmentee)
ENABLE_RAG=false

# Activer/desactiver la recherche web
ENABLE_WEB_SEARCH=false

# Mode securise
SAFE_MODE=false

# ===========================================
# Performance
# ===========================================
# Activer CUDA si disponible (GPU NVIDIA)
# USE_CUDA=true

# Mode hors ligne (pas de telechargement)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ===========================================
# Reseau
# ===========================================
# CORS (en developpement uniquement)
# CORS_ALLOW_ORIGIN=http://localhost:5173

# Adresse d'ecoute
# WEBUI_HOST=0.0.0.0
# WEBUI_PORT=8080
